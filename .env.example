# Premier compte (l'avocat), créé automatiquement au premier démarrage
ADMIN_NAME=Maître Daniel RODRIGUEZ
ADMIN_EMAIL=avocat.rodriguez@proton.me
ADMIN_PASSWORD=
# Mettre true pour réinitialiser ce compte (mot de passe oublié), puis retirer
ADMIN_RESET=false

# true dès que le site est servi en HTTPS (Railway : toujours true)
COOKIE_SECURE=true

# Durée de connexion avant de devoir se reconnecter (jours)
SESSION_DAYS=30
